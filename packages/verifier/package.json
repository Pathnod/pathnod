{
  "name": "@pathnod/verifier",
  "version": "0.1.0",
  "private": true,
  "description": "Off-chain Pathnod attestation verifier.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "node --eval \"fs.rmSync('dist', { force: true, recursive: true })\"",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "5.9.3"
  }
}
