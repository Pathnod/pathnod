{
  "name": "@pathnod/verifier",
  "version": "0.1.0",
  "private": true,
  "description": "Off-chain attestation and observer enrollment verifier for Pathnod.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "Apple_App_Attestation_Root_CA.crt"
  ],
  "engines": {
    "node": "24.21.0",
    "pnpm": "11.27.1"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "node --eval \"fs.rmSync('dist', { force: true, recursive: true })\"",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "enrollment:serve": "node dist/enrollment-http.js",
    "roots:verify": "node scripts/dev28-roots.ts",
    "eligibility:verify": "node scripts/dev29-eligibility.ts"
  },
  "dependencies": {
    "@pathnod/solana": "workspace:*",
    "@solana/web3.js": "1.98.4",
    "circomlibjs": "0.1.7"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "5.9.3"
  }
}
